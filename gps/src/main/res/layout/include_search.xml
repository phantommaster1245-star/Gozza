<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:outlineProvider="none"
    >
    <!-- android:animateLayoutChanges="true" -->

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/geox_panel"
        android:textColor="#EFF5F0" android:textColorHint="#9AA8A3" android:drawableTint="#EFF5F0"
        android:drawableStart="@drawable/ic_baseline_search_24"
        android:drawablePadding="@dimen/padding_16"
        android:hint="@string/geox_search"
        android:imeOptions="actionSearch"
        android:inputType="text" android:singleLine="true" android:textSize="14sp"
        android:paddingStart="@dimen/padding_16"
        android:paddingEnd="52dp"   
    />

    <ProgressBar
        android:id="@+id/search_progress"
        android:layout_width="@dimen/progressbar_size"
        android:layout_height="@dimen/progressbar_size"
        android:layout_marginEnd="24dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="@dimen/padding_8" 
    />

</RelativeLayout>